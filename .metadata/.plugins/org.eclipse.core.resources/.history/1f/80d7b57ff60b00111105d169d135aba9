			}
		}else {
			factorMinus.struct = factorMinus.getFactor().struct;
		}
	}
	
	
	
	/*----- DESIGNATOR  -----*/
	
	@Override
	public void visit(Designator_only designator_only) {
		Obj varObj = Tab.find(designator_only.getDesignatorName().getI1());
		if(varObj == Tab.noObj) {
			report_error("Pristup nedefinisanoj promenljivi: " + designator_only.getDesignatorName().getI1(), designator_only);
			designator_only.obj = Tab.noObj;
		}
		else if(varObj.getKind() != Obj.Var && varObj.getKind() != Obj.Con && varObj.getKind() != Obj.Meth) {
			report_error("Neadekvatna promenljiva: " + designator_only.getDesignatorName().getI1(), designator_only);
			designator_only.obj = Tab.noObj;
		}
		else {
			designator_only.obj = varObj;
		}
	}
	
	
	@Override
	public void visit(DesignatorName designatorName) {
		Obj varObj = Tab.find(designatorName.getI1());
		if(varObj.getName() == "this") {
			report_error("This ne sme da se javi kao designator", designatorName);
		}
		if(varObj == Tab.noObj || varObj == null) {
			report_error("Nije pronadjen simbol " + designatorName.getI1(), designatorName);
			designatorName.obj = Tab.noObj;
		}
		else {
			designatorName.obj = varObj;
			if(varObj.getKind() == Obj.Con) {
				report_info("Pristup simbolickoj konstanti: " + varObj.getName() + " [Kind: " + getKindString(varObj.getKind()) + "]" + "[Type: " +
						getTypeString(varObj.getType().getKind()) + "]" , designatorName);
			}
			else if(varObj.getKind() == Obj.Var){
				if(Tab.currentScope.findSymbol(designatorName.getI1()) == null) {
					report_info("Pristup globalnoj promenljivoj: " + varObj.getName() + " [Kind: " + getKindString(varObj.getKind()) + "]" + "[Type: " +
							getTypeString(varObj.getType().getKind()) + "]" , designatorName);
				}
				else if(varObj.getFpPos() > 0) {
					report_info("Pristup formalnom parametru: " + varObj.getName() + " [Kind: " + getKindString(varObj.getKind()) + "]" + "[Type: " +
							getTypeString(varObj.getType().getKind()) + "]" , designatorName);
                	return;
				}else {
					report_info("Pristup lokalnoj promenljivoj: " + varObj.getName() + " [Kind: " + getKindString(varObj.getKind()) + "]" + "[Type: " +
							getTypeString(varObj.getType().getKind()) + "]" , designatorName);
				}
			}
		}
	}
	
	
	@Override
	public void visit(Designator_enum designator_enum) {
		Obj varObj = designator_enum.getDesignatorName().obj; // ovo treba da bude npr Broj cvor
		if(varObj == Tab.noObj) {
			report_error("Nije pronadjen simbol " + designator_enum.getDesignatorName().getI1(), designator_enum);
			designator_enum.obj = Tab.noObj;
		}
		else {
			if(varObj.getType().getKind() != Struct.Enum) {
				report_error("Tip designatora mora biti enum", designator_enum);
				varObj = Tab.noObj;
			}else {
				for(Obj elem : varObj.getLocalSymbols()) { 
					if(elem.getName().equals(designator_enum.getI2())) {
						designator_enum.obj = elem;
						//currentType = Tab.intType;	
						return;
					}
				}
				report_error(designator_enum.getI2() + " ne postoji u ENUM-u", designator_enum);
				designator_enum.obj = Tab.noObj;
				currentType = Tab.noType;
			}
		}		
	}
	
	@Override
	public void visit(Designator_len designator_len) {
		Obj varObj = designator_len.getDesignatorName().obj;
		if(varObj == Tab.noObj) {
			designator_len.obj = Tab.noObj;
		}else {
			if(varObj.getType().getKind() != Struct.Array) {
				report_error("Samo nizovi imaju length polje", designator_len);
