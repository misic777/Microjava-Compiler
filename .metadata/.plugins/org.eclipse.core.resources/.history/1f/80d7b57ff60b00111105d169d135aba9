	/*----- DESIGNATOR STATEMENT  -----*/
		
	@Override
	public void visit(DesignatorStatementA_Assignop designatorStatementA_Assignop) {
	    Obj designator = designatorStatementA_Assignop.getDesignator().obj;
	    Struct dstType = designator.getType();
	    Struct srcType = designatorStatementA_Assignop.getExpr().struct;
	    
	    if (designator.getKind() != Obj.Var && designator.getKind() != Obj.Elem) {
	        report_error("Operacija dodele za neadekvatnu promenljivu", designatorStatementA_Assignop);
	        return;
	    }

	    if (srcType.assignableTo(dstType)) {
	        return;
	    }
	    if (dstType.equals(Tab.intType) && srcType.getKind() == Struct.Enum) {
	        return;
	    }
	    report_error("Dodela neadekvatne vrednosti u " + designator.getName(), designatorStatementA_Assignop);
	}

	
	
	
	@Override
	public void visit(DesignatorStatementO_inc designatorStatementO_inc) {
		Obj designator = designatorStatementO_inc.getDesignator().obj;
		
		if(designator.getKind() != Obj.Var && designator.getKind() != Obj.Elem) {
			report_error("Inc nad neadkvatnom promenljivom " + designator.getName(), designatorStatementO_inc);
		}
		if(!designator.getType().equals(Tab.intType)) {
			report_error("Inc promenljive " + designator.getName()  +" koja nije int", designatorStatementO_inc);
		}
		report_info("Pristup promenljivoj: " + designator.getName() + " [Kind: " + getKindString(designator.getKind()) + "]" + "[Type: " +
				getTypeString(designator.getType().getKind()) + "]" , designatorStatementO_inc);
	}
	
	@Override
	public void visit(DesignatorStatementO_dec designatorStatementO_dec) {
		Obj designator = designatorStatementO_dec.getDesignator().obj;
		
		if(designator.getKind() != Obj.Var && designator.getKind() != Obj.Elem) {
			report_error("Inc nad neadkvatnom promenljivom " + designator.getName(), designatorStatementO_dec);
		}
		if(!designator.getType().equals(Tab.intType)) {
			report_error("Inc promenljive " + designator.getName()  +" koja nije int", designatorStatementO_dec);
		}
		report_info("Pristup promenljivoj: " + designator.getName() + " [Kind: " + getKindString(designator.getKind()) + "]" + "[Type: " +
				getTypeString(designator.getType().getKind()) + "]" , designatorStatementO_dec);
	}
	
	@Override
	public void visit(DesignatorStatementO_meth designatorStatementO_meth) {
		Obj methObj = designatorStatementO_meth.getDesignator().obj;
		if(methObj.getKind() != Obj.Meth) {
			report_error("Poziv neadekvatne metode" + designatorStatementO_meth.getDesignator().obj.getName(), designatorStatementO_meth);
			return;
		}
		int expected = methObj.getLevel();
		int actual = actParsTypes.size();
		System.out.println(expected);
		System.out.println(actual);
				
		if (expected != actual) {
	        report_error(
	            "Metoda " + methObj.getName() +
	            " ocekuje " + expected +
	            " parametara, a dobila je " + actual,
	            designatorStatementO_meth
	        );
	    }else {
	    	ArrayList<Obj> formals = new ArrayList<>();

	        for (Obj o : methObj.getLocalSymbols()) {
	            //if (o.getFpPos() > 0) {
	        	if(o.getKind() == Obj.Var) {
	                formals.add(o);
	            }
	        }

	        formals.sort((a, b) -> Integer.compare(a.getFpPos(), b.getFpPos()));
	        System.out.println(formals.size());
	        for (int i = 0; i < formals.size(); i++) {
	            Struct formalType = formals.get(i).getType();
	            Struct actualType = actParsTypes.get(i);

	            if (actualType.assignableTo(formalType)) {
	                continue;
	            }
	            
	            if (formalType.equals(Tab.intType) &&
	                actualType.getKind() == Struct.Enum) {
	                continue;
	            }
	            report_error("Neodgovarajuci tip " + (i + 1) + ". parametra u pozivu metode " + methObj.getName(), designatorStatementO_meth);
	            break;
	        }
	    }
		
		report_info("Pozivanje globalne funkcije " + methObj.getName() + " [Kind: " + getKindString(methObj.getKind()) + "]" + "[Type: " + 
		getTypeString(methObj.getType().getKind()) + "]" , designatorStatementO_meth);

	    actParsTypes.clear();
	}
	
