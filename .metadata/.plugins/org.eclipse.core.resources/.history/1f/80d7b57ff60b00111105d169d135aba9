	@Override
	public void visit(Factor_meth factor_meth) {
		Obj methObj = factor_meth.getDesignator().obj;
		if(methObj.getKind() != Obj.Meth) {
			report_error("Poziv neadekvatne metode " +factor_meth.getDesignator().obj.getName() , factor_meth);
			factor_meth.struct = Tab.noType;
		} else {
			factor_meth.struct = factor_meth.getDesignator().obj.getType();
		}
		
		int expected = methObj.getLevel();
	    int actual = actParsTypes.size();

	    if (expected != actual) {
	        report_error("Metoda " + methObj.getName() +
	                     " ocekuje " + expected +
	                     " parametara, a dobila je " + actual,
	                     factor_meth);
	        actParsTypes.clear();
	        return;
	    }

	    ArrayList<Obj> formals = new ArrayList<>();
	    for (Obj o : methObj.getLocalSymbols()) {
	        if (o.getFpPos() > 0) formals.add(o);
	    }

	    formals.sort((a, b) -> Integer.compare(a.getFpPos(), b.getFpPos()));

	    for (int i = 0; i < formals.size(); i++) {
	        Struct f = formals.get(i).getType();
	        Struct a = actParsTypes.get(i);

	        if (a.assignableTo(f)) continue;
	        if (f.equals(Tab.intType) && a.getKind() == Struct.Enum) continue;

	        report_error("Neodgovarajuci tip " + (i + 1) +
	                     ". parametra u pozivu metode " + methObj.getName(),
	                     factor_meth);
	        break;
	    }
	    report_info("Pozivanje globalne funkcije " + methObj.getName() + " [Kind: " + getKindString(methObj.getKind()) + "]" + "[Type: " +
	    		getTypeString(methObj.getType().getKind()) + "]" , factor_meth);
	    actParsTypes.clear();
	}
	
