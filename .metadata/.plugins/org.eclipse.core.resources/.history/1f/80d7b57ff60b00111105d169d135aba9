				return "Var";
			case 2:
				return "Type";
			case 3:
				return "Meth";
			case 4:
				return "Fld";
			case 5:
				return "Elem";
			case 6:
				return "Prog";
				
		}
		return "Nepostojeci tip";
	}
	
	private String getTypeString(int i) {
		switch(i) {
			case 0:
				return "None";
			case 1:
				return "Int";
			case 2:
				return "Char";
			case 3:
				return "Array";
			case 4:
				return "Class";
			case 5:
				return "Bool";
			case 6:
				return "Enum";
			case 7:
