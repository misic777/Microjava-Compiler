	@Override
	public void visit(Designator_arrElem designator_arrElem) {
		Obj arrObj = designator_arrElem.getDesignatorName().obj;
		if(arrObj == Tab.noObj) {
			designator_arrElem.obj = Tab.noObj;
		}
		else {
			if(arrObj.getType().getKind() != Struct.Array) {
				report_error("Promenljiva mora biti niz da bi se indeksirala", designator_arrElem);
				designator_arrElem.obj = Tab.noObj;
			}
			
			Struct index = designator_arrElem.getExpr().struct;
			
			if(!index.equals(Tab.intType) && index.getKind() != Struct.Enum) {
				report_error("Niz mora biti indeksiran int-om", designator_arrElem);
				designator_arrElem.obj = Tab.noObj;
			}
			else {
				designator_arrElem.obj = new Obj(Obj.Elem, arrObj.getName() + "[$]", arrObj.getType().getElemType());
				report_info("Pristup elementu niza: " + arrObj.getName() + " [Kind: " + getKindString(designator_arrElem.obj.getKind()) + "]" + "[Type: " +
						getTypeString(designator_arrElem.obj.getType().getKind()) + "]" , designator_arrElem);
			}
		}
	}
	


