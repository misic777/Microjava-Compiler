		currentEnum.setLevel(currentEnum.getLevel() + 1); // br clanova enuma
		conObj.setAdr(constant);
		nextEnumVal = ++constant;
	}
	
	@Override
	public void visit(AssignConst_noVal assignConst_noVal) {
		Obj conObj = Tab.currentScope.findSymbol(assignConst_noVal.getI1());
		if(conObj != null) {
			report_error("Dvostruka definicija konstante: " + assignConst_noVal.getI1(), assignConst_noVal);
		}
		//constantType = Tab.intType; // Nepotrebno ali cisto da bude konzistentno
		conObj = Tab.insert(Obj.Con, assignConst_noVal.getI1(), currentEnum.getType()); // Videti koji tip da se koristi ovde i zasto ne uvlaci lepo u ast-u
		//conObj.setFpPos(currentEnum.getLevel() + 1);
		currentEnum.setLevel(currentEnum.getLevel() + 1); // br clanova enuma
		conObj.setAdr(nextEnumVal++);
	}

