	@Override
	public void visit(CondFact_Relop condFact_Relop) {
		Struct left = condFact_Relop.getNonTernaryExpr().struct;
		Struct right = condFact_Relop.getNonTernaryExpr1().struct;
		if(left.compatibleWith(right)) {
			if((left.getKind() == Struct.Array && right.getKind() == Struct.Array)) {
				if(condFact_Relop.getRelop() instanceof Relop_eq || condFact_Relop.getRelop() instanceof Relop_ne) {
					condFact_Relop.struct = boolType;
				}
				else {
					report_error("Poredjenje tipova neadekvatnim relacionim operatorom ", condFact_Relop);
					condFact_Relop.struct = Tab.noType;
				}
			} else {
				condFact_Relop.struct = boolType;
			}
			
		}
		else {
			report_error("Tipovi nisu kompatibilni", condFact_Relop);
			condFact_Relop.struct = Tab.noType;
		}
		
	}
	
